generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  workouts     Workout[]
  metrics      BodyMetric[]
}

model Exercise {
  id          String             @id @default(cuid())
  name        String             @unique
  muscleGroup String
  equipment   String
  sets        WorkoutSet[]
  planned     WorkoutExercise[]
}

model Workout {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  sets       WorkoutSet[]
  exercises  WorkoutExercise[]

  @@index([userId, startedAt])
}

model WorkoutExercise {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  sortOrder  Int

  @@unique([workoutId, exerciseId])
}

model WorkoutSet {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  setIndex   Int
  weightKg   Float
  reps       Int
  createdAt  DateTime @default(now())
}

model BodyMetric {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg  Float
  loggedAt  DateTime @default(now())
}
